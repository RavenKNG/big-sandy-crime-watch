generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ContentStatus {
  DRAFT
  REVIEW
  PUBLISHED
  HIDDEN
}

enum PublishStatus {
  DRAFT
  APPROVED
  PUBLISHED
  HIDDEN
  REJECTED
}

enum FacebookStatus {
  NOT_QUEUED
  DRAFTED
  QUEUED
  POSTED
  FAILED
  MANUAL_REQUIRED
}

enum CorrectionType {
  CORRECTION
  HIDE
  DEINDEX
  EXPUNGEMENT
  OTHER
}

enum CorrectionStatus {
  NEW
  REVIEWING
  RESOLVED
  DENIED
}

model Article {
  id String @id @default(cuid())
  slug String @unique
  title String
  summary String
  body String
  category String
  county String?
  status ContentStatus @default(DRAFT)
  sourceName String?
  sourceUrl String?
  sourcePublishedAt DateTime?
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  facebookDrafts FacebookDraft[]
  corrections CorrectionRequest[]
}

model PublicRecordDemo {
  id String @id @default(cuid())
  slug String @unique
  displayName String
  age Int?
  gender String?
  city String?
  arrestingAgency String?
  arrestingOfficer String?
  county String?
  state String?
  sourceRecordId String? @unique
  sourceFingerprint String? @unique
  bookingDateTimeText String?
  bookingDate DateTime
  bookingTimeKnown Boolean @default(true)
  recordDate DateTime
  status String?
  sourceName String
  sourceUrl String?
  sourceTimestamp DateTime
  imageUrl String?
  imageLocalPath String?
  publishStatus PublishStatus @default(DRAFT)
  facebookPostStatus FacebookStatus @default(NOT_QUEUED)
  viewCount Int @default(0)
  complianceNotes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  charges ChargeDemo[]
  facebookDrafts FacebookDraft[]
  corrections CorrectionRequest[]
}

model ChargeDemo {
  id String @id @default(cuid())
  recordId String
  record PublicRecordDemo @relation(fields: [recordId], references: [id], onDelete: Cascade)
  offense String
  statute String?
  chargeDescription String
  caseNumber String?
  displayOrder Int @default(0)
}

model SourceImportRun {
  id String @id @default(cuid())
  sourceName String
  startedAt DateTime @default(now())
  finishedAt DateTime?
  recordsFound Int @default(0)
  recordsCreated Int @default(0)
  recordsSkipped Int @default(0)
  errorsJson Json?
}

model FacebookDraft {
  id String @id @default(cuid())
  articleId String?
  article Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)
  recordId String?
  record PublicRecordDemo? @relation(fields: [recordId], references: [id], onDelete: Cascade)
  status FacebookStatus @default(DRAFTED)
  scheduledFor DateTime?
  postText String
  postUrl String
  imageUrl String?
  facebookPostId String?
  facebookCommentId String?
  errorMessage String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CorrectionRequest {
  id String @id @default(cuid())
  articleId String?
  article Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  recordId String?
  record PublicRecordDemo? @relation(fields: [recordId], references: [id], onDelete: SetNull)
  name String
  email String
  requestType CorrectionType
  relatedUrl String?
  message String
  status CorrectionStatus @default(NEW)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SponsorAd {
  id String @id @default(cuid())
  name String
  placement String
  imageUrl String?
  linkUrl String?
  text String?
  enabled Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PublishLog {
  id String @id @default(cuid())
  targetType String
  targetId String
  action String
  message String
  createdAt DateTime @default(now())
}

model FacebookConnection {
  id String @id @default("primary")
  pageId String
  pageName String
  encryptedPageToken String
  tokenStatus String @default("UNKNOWN")
  tokenExpiresAt DateTime?
  dataAccessExpiresAt DateTime?
  lastHealthCheckAt DateTime?
  lastSuccessfulPostAt DateTime?
  lastFacebookError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
